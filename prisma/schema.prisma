// Dra. Melissa Vigo — Prisma schema.
//
// Default provider is PostgreSQL (Neon, Vercel Postgres, Supabase, etc.).
// Set DATABASE_URL in Vercel Environment Variables before deploying.
//
// Learn more: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

/// Lead captured from the public contact form.
model Lead {
    id          String   @id @default(cuid())
    nombre      String
    email       String
    telefono    String
    tratamiento String
    mensaje     String
    sede        String?
    source      String   @default("contact-form")
    ip          String?
    userAgent   String?
    consentAt   DateTime
    createdAt   DateTime @default(now())

    @@index([createdAt])
    @@index([email])
}
