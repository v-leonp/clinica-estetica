# Copy this file to `.env` and fill in the values.
# Env validation lives in src/env.js (@t3-oss/env-nextjs).
# You can skip validation with SKIP_ENV_VALIDATION=1.

# ---- Database ---------------------------------------------------------
# Opción A — Vercel Postgres (recomendado en Vercel):
#   Storage → Create Database → Postgres. Vercel inyecta POSTGRES_URL y
#   POSTGRES_URL_NON_POOLING; el build las mapea automáticamente.
#
# Opción B — Neon / Supabase / otro Postgres:
DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"

# ---- Public canonical site URL ----------------------------------------
# Used in metadata (canonical, OG) and the sitemap. On Vercel this is
# normally set automatically; see src/lib/site-url.ts for fallbacks.
# NEXT_PUBLIC_SITE_URL="https://www.lumina-estetica.com"

# ---- Rate limit (optional) --------------------------------------------
# When both are set, /api/trpc uses Upstash Ratelimit (fixed window per IP).
# When unset, a safe in-memory limiter is used (fine for local dev; use
# Upstash in production so limits are shared across Vercel invocations).
# UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="xxxxxxxxxxxxxxxx"
